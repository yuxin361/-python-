# ===================== LLM API 配置 =====================
# 任选一种配置即可，优先级：OPENAI_API_KEY > DASHSCOPE_API_KEY > DEEPSEEK_API_KEY

# OpenAI / 兼容 OpenAI 接口的 API
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# 通义千问 (DashScope)
# DASHSCOPE_API_KEY=your-dashscope-key

# DeepSeek
# DEEPSEEK_API_KEY=your-deepseek-key

# ===================== 模型名称 =====================
# 默认使用 gpt-4o，可根据需要切换
LLM_MODEL=gpt-4o

# ===================== 搜索配置 =====================
# 必应搜索 API Key（可选，不配置则使用模拟搜索）
BING_SEARCH_API_KEY=